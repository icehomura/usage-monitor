{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Usage Monitor",
  "version": "0.4.1",
  "identifier": "com.icehomura.usage-monitor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Usage Monitor - 用量与额度监控",
        "width": 1100,
        "height": 640,
        "minWidth": 800,
        "minHeight": 480,
        "visible": true,
        "resizable": true,
        "decorations": false,
        "backgroundColor": "#0f1420"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app", "appimage", "deb"],
    "icon": [
      "../icons/32x32.png",
      "../icons/128x128.png",
      "../icons/128x128@2x.png",
      "../icons/icon.ico"
    ]
  },
  "plugins": {
    "autostart": null
  }
}
